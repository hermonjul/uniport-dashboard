# Rahasia sisi server — JANGAN diberi awalan VITE_ (awalan itu membuat Vite memasukkannya ke browser).
# Kunci AES-256 (32 byte, base64url). Buat dengan: npm run kunci
AKSES_KUNCI=
# Port layanan API akses (bawaan 8787)
AKSES_PORT=8787
# Asal (origin) yang boleh memanggil API langsung, dipisah koma. Kosong = hanya lewat proxy dev server.
AKSES_ASAL_DIIZINKAN=
# URL dasar portal untuk tautan hasil `npm run link`
PORTAL_URL=http://127.0.0.1:5175/
# Backend Go (Matrix). Dev server meneruskan /api-go/* ke sini (lihat vite.config.ts).
URL_GO=http://192.168.10.97:8080/api/v1/matrix/
# Akses lewat tautan terenkripsi. 'aktif' = wajib tautan ?akses=… (butuh npm run api).
# Kosong/lainnya = URL dibuka seperti biasa, langsung portal Direksi. (Aman diberi VITE_: bukan rahasia.)
VITE_AKSES_TAUTAN=
